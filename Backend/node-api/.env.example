# =============================================
# CONFIGURAÇÃO DO AMBIENTE — SRFS (exemplo)
# Copia este ficheiro para .env e preenche
# =============================================

# Servidor Node.js
PORT=3001
NODE_ENV=development

# Base de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_services
DB_USER=postgres
DB_PASSWORD=password_segura_aqui

# JWT — gera um segredo forte com: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=substituir_por_segredo_jwt_aqui
JWT_EXPIRES_IN=7d

# Serviço ML (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000
